{
  "name": "java-ai-kb",
  "version": "2.0.0",
  "description": "Java AI 工程师知识库 — 静态站点生成器",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "node src/build.mjs",
    "validate": "node src/validate.mjs",
